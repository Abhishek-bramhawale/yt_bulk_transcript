{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "devCommand": "cd client && vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}